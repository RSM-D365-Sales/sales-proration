  <Name>RSMItemSubstitutionGroupMember</Name>
  <SourceCode>
    <Declaration><![CDATA[
/// <summary>
/// One item in an interchangeable group (RSMItemSubstitutionGroup). EquivQty
/// is how much one case of the item is worth in the group's unit; Sequence is
/// the preference order when the item is offered as a substitute (1 first).
/// </summary>
public class RSMItemSubstitutionGroupMember extends common
{
}
]]></Declaration>
    <Methods>
      <Method>
        <Name>validateWrite</Name>
        <Source><![CDATA[
public boolean validateWrite()
{
    boolean ok = super();
    if (ok && this.EquivQty <= 0)
    {
        ok = checkFailed("Equivalent quantity must be greater than 0.");
    }
    return ok;
}
]]></Source>
      </Method>
    </Methods>
  </SourceCode>
