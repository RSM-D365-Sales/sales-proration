// File: RSMSubstitutionRuleConsumer.xpp
// Model:  RSM_SalesProration
// Purpose: Invoked by the message processor for queue
//          `rsmSalesProrateAccelerator`, message type
//          `rsmSalesSubstitutionRuleMessage`. Applies substitution master-data
//          changes made on the web app's Substitutions page (or approved for a
//          customer in the planner's picker):
//            · Rules              upsert / delete RSMItemSubstitution rows
//            · SubstitutionGroups upsert / delete RSMItemSubstitutionGroup and
//                                 replace its RSMItemSubstitutionGroupMember rows
//            · CustomerPolicies   set CustTable.RSMSubstitutionPolicy + note
//
// The app publishes this message BEFORE any substitution batch that relies on
// a rule approved in the same session, so RSMSubstitutionConsumer finds the
// rule when its batch arrives (same queue, processed in order).
//
// _messageContent (RSMSubstitutionRuleBatchContract):
//   { "BatchId": "…",
//     "Rules": [{ "Action": "Upsert"|"Delete", "RuleId", "FromItemId", "ToItemId",
//                 "CustAccount", "Direction", "Rank", "QtyRatio",
//                 "PriceBasis": "OriginalItemPrice"|"SubstituteItemPrice",
//                 "ValidFrom", "ValidTo" }],
//     "SubstitutionGroups": [{ "Action", "GroupId", "Name", "Unit", "PriceBasis",
//                 "ValidFrom", "ValidTo", "Note",
//                 "Members": [{ "ItemId", "EquivQty", "Sequence" }] }],
//     "CustomerPolicies": [{ "CustAccount", "SubstitutionPolicy": "Standard"|"CustomerOnly"|"Never", "Note" }] }
//
// Security: the publishing endpoint requires Proration.Admin; on the D365
// side the integration user needs RSMItemSubstitutionMaintain.
// Idempotency: BatchId unique-indexed in RSMProrationAuditLog, same as the
// other consumers. Upserts are keyed on RuleId, falling back to the
// (FromItemId, ToItemId, CustAccount) unique index.

public class RSMSubstitutionRuleConsumer
{
    public ProrationApplied apply(RSMSubstitutionRuleBatchContract _batch)
    {
        if (RSMProrationAuditLog::existsBatch(_batch.parmBatchId()))
        {
            return RSMProrationEventBuilder::alreadyApplied(_batch.parmBatchId());
        }

        List results = new List(Types::Class);

        ttsbegin;

        RSMProrationAuditLog audit;
        audit.BatchId     = _batch.parmBatchId();
        audit.ReceivedUtc = DateTimeUtil::utcNow();
        audit.insert();

        // 1. Rules
        ListEnumerator re = _batch.parmRules().getEnumerator();
        while (re.moveNext())
        {
            RSMSubstitutionRuleRecordContract rec = re.current();
            RSMItemSubstitution sub = RSMSubstitutionRuleConsumer::findForUpdate(rec);

            if (rec.parmAction() == 'Delete')
            {
                if (sub) { sub.delete(); }
                results.addEnd(RSMProrationEventBuilder::ruleApplied(rec.parmRuleId(), 'Deleted'));
                continue;
            }

            if (!InventTable::exist(rec.parmFromItemId()) || !InventTable::exist(rec.parmToItemId()))
            {
                results.addEnd(RSMProrationEventBuilder::ruleFailed(rec.parmRuleId(), 'Unknown item'));
                continue;
            }
            if (rec.parmCustAccount() && !CustTable::exist(rec.parmCustAccount()))
            {
                results.addEnd(RSMProrationEventBuilder::ruleFailed(rec.parmRuleId(), 'Unknown customer'));
                continue;
            }

            boolean isNew = !sub.RecId;
            sub.RuleId      = rec.parmRuleId();
            sub.FromItemId  = rec.parmFromItemId();
            sub.ToItemId    = rec.parmToItemId();
            sub.CustAccount = rec.parmCustAccount();
            sub.Direction   = symbol2Enum(enumNum(RSMSubstitutionDirection), rec.parmDirection());
            sub.Rank        = rec.parmRank() ? rec.parmRank() : 1;
            sub.QtyRatio    = rec.parmQtyRatio() > 0 ? rec.parmQtyRatio() : 1.0;
            sub.PriceBasis  = symbol2Enum(enumNum(RSMSubstitutionPriceBasis), rec.parmPriceBasis());
            sub.ValidFrom   = rec.parmValidFrom();
            sub.ValidTo     = rec.parmValidTo();

            if (!sub.validateWrite())
            {
                results.addEnd(RSMProrationEventBuilder::ruleFailed(rec.parmRuleId(), 'Validation failed'));
                continue;
            }
            if (isNew) { sub.insert(); } else { sub.update(); }
            results.addEnd(RSMProrationEventBuilder::ruleApplied(rec.parmRuleId(), isNew ? 'Created' : 'Updated'));
        }

        // 2. Interchangeable groups. An upsert replaces the whole member list,
        //    so the group in D365 always matches what the planner saw.
        ListEnumerator ge = _batch.parmSubstitutionGroups().getEnumerator();
        while (ge.moveNext())
        {
            RSMSubstitutionGroupRecordContract grec = ge.current();
            RSMItemSubstitutionGroup grp = RSMItemSubstitutionGroup::find(grec.parmGroupId(), true);

            if (grec.parmAction() == 'Delete')
            {
                if (grp) { grp.delete(); }   // cascades to the members
                results.addEnd(RSMProrationEventBuilder::ruleApplied(grec.parmGroupId(), 'Group deleted'));
                continue;
            }

            // Validate every member before touching anything.
            str bad = RSMSubstitutionRuleConsumer::checkGroupMembers(grec);
            if (bad)
            {
                results.addEnd(RSMProrationEventBuilder::ruleFailed(grec.parmGroupId(), bad));
                continue;
            }

            boolean isNew = !grp.RecId;
            grp.GroupId    = grec.parmGroupId();
            grp.Name       = grec.parmName();
            grp.Unit       = grec.parmUnit();
            grp.PriceBasis = symbol2Enum(enumNum(RSMSubstitutionPriceBasis), grec.parmPriceBasis());
            grp.ValidFrom  = grec.parmValidFrom();
            grp.ValidTo    = grec.parmValidTo();
            grp.Note       = grec.parmNote();
            if (isNew) { grp.insert(); } else { grp.update(); }

            RSMItemSubstitutionGroupMember member;
            delete_from member where member.GroupId == grp.GroupId;

            ListEnumerator me = grec.parmMembers().getEnumerator();
            while (me.moveNext())
            {
                RSMSubstitutionGroupMemberContract mrec = me.current();
                member.clear();
                member.GroupId  = grp.GroupId;
                member.ItemId   = mrec.parmItemId();
                member.EquivQty = mrec.parmEquivQty();
                member.Sequence = mrec.parmSequence();
                member.insert();
            }
            results.addEnd(RSMProrationEventBuilder::ruleApplied(grec.parmGroupId(), isNew ? 'Group created' : 'Group updated'));
        }

        // 3. Customer policies
        ListEnumerator pe = _batch.parmCustomerPolicies().getEnumerator();
        while (pe.moveNext())
        {
            RSMSubstitutionPolicyRecordContract pol = pe.current();
            CustTable cust = CustTable::find(pol.parmCustAccount(), true);
            if (!cust)
            {
                results.addEnd(RSMProrationEventBuilder::ruleFailed(pol.parmCustAccount(), 'Unknown customer'));
                continue;
            }
            cust.RSMSubstitutionPolicy = symbol2Enum(enumNum(RSMSubstitutionPolicy), pol.parmSubstitutionPolicy());
            cust.RSMSubstitutionNote   = pol.parmNote();
            cust.update();
            results.addEnd(RSMProrationEventBuilder::ruleApplied(pol.parmCustAccount(), 'Policy set'));
        }

        ttscommit;

        return RSMProrationEventBuilder::batchApplied(_batch.parmBatchId(), results);
    }

    /// <summary>Blank when the group's members are valid, else the reason. Same checks as Subs.validateGroup.</summary>
    private static str checkGroupMembers(RSMSubstitutionGroupRecordContract _grec)
    {
        Set  seen = new Set(Types::String);
        str  commodity;
        int  n;

        if (!_grec.parmGroupId() || !_grec.parmName())
        {
            return 'Group id and name are required';
        }
        ListEnumerator me = _grec.parmMembers().getEnumerator();
        while (me.moveNext())
        {
            RSMSubstitutionGroupMemberContract m = me.current();
            InventTable it = InventTable::find(m.parmItemId());
            if (!it)                     { return strFmt('Unknown item %1', m.parmItemId()); }
            if (m.parmEquivQty() <= 0)   { return strFmt('Equivalent qty must be > 0 for %1', m.parmItemId()); }
            if (seen.in(m.parmItemId())) { return strFmt('%1 appears twice', m.parmItemId()); }
            seen.add(m.parmItemId());
            str c = EcoResProduct::find(it.Product).RSMCommodityId;
            if (n && c != commodity)     { return 'Every member must be in the same buyer group'; }
            commodity = c;
            n++;
        }
        return n < 2 ? 'A group needs at least two items' : '';
    }

    /// <summary>Existing row for an upsert/delete: by RuleId, else by the (From, To, Customer) key.</summary>
    private static RSMItemSubstitution findForUpdate(RSMSubstitutionRuleRecordContract _rec)
    {
        RSMItemSubstitution sub;

        if (_rec.parmRuleId())
        {
            select firstonly forupdate sub where sub.RuleId == _rec.parmRuleId();
        }
        if (!sub)
        {
            select firstonly forupdate sub
                where sub.FromItemId  == _rec.parmFromItemId()
                   && sub.ToItemId    == _rec.parmToItemId()
                   && sub.CustAccount == _rec.parmCustAccount();
        }
        return sub;
    }
}
