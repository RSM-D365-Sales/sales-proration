// File: RSMProrationSubstitutionService.xpp
// Model:  RSM_SalesProration
// Purpose: Read service exposing the RSMItemSubstitution whitelist to the
//          external proration app.
//
// Wire-up options (either works; the web app tolerates both):
//   a) Preferred — add `substitutions` (getSubstitutions) and
//      `substitutionGroups` (getSubstitutionGroups) collections to the
//      snapshot payload returned by SPASalesOrderService.GetOpenSalesOrders,
//      so the app gets rules and groups in the same single call as
//      demand/supply/customers.
//   b) Standalone — register this service in RSMProrationReadSvcGrp and let
//      the app call it separately.

public class RSMProrationSubstitutionService
{
    /// <summary>
    /// Substitution rules, optionally scoped to one commodity (returns rules
    /// where either side belongs to the commodity). Expired rules are left
    /// out; scheduled ones (ValidFrom in the future) are included so the
    /// app's rules page can show them. The app and RSMSubstitutionConsumer
    /// both check the validity window before using a rule.
    /// </summary>
    [SysEntryPointAttribute]
    public List getSubstitutions(str _commodityId = '')
    {
        List                result = new List(Types::Class);
        RSMItemSubstitution sub;
        TransDate           today  = systemDateGet();

        while select sub
            order by sub.FromItemId, sub.Rank
            where (!sub.ValidTo || sub.ValidTo >= today)
        {
            if (_commodityId
                && !RSMProrationSubstitutionService::itemInCommodity(sub.FromItemId, _commodityId)
                && !RSMProrationSubstitutionService::itemInCommodity(sub.ToItemId,   _commodityId))
            {
                continue;
            }

            RSMProrationSubstitutionContract c = new RSMProrationSubstitutionContract();
            c.parmFromItemId(sub.FromItemId);
            c.parmToItemId(sub.ToItemId);
            c.parmDirection(enum2Symbol(enumNum(RSMSubstitutionDirection), sub.Direction));
            c.parmRank(sub.Rank);
            c.parmQtyRatio(sub.QtyRatio ? sub.QtyRatio : 1.0);
            c.parmCustAccount(sub.CustAccount);
            c.parmRuleId(sub.RuleId);
            c.parmPriceBasis(enum2Symbol(enumNum(RSMSubstitutionPriceBasis), sub.PriceBasis));
            c.parmValidFrom(sub.ValidFrom);
            c.parmValidTo(sub.ValidTo);
            c.parmNote(sub.Note);
            result.addEnd(c);
        }
        return result;
    }

    /// <summary>
    /// Interchangeable groups that are not expired, with members in
    /// preference order; feeds the snapshot's `substitutionGroups` collection.
    /// Optionally scoped to groups with a member in one commodity.
    /// </summary>
    [SysEntryPointAttribute]
    public List getSubstitutionGroups(str _commodityId = '')
    {
        List                     result = new List(Types::Class);
        RSMItemSubstitutionGroup grp;
        TransDate                today  = systemDateGet();

        while select grp
            order by grp.Name
            where (!grp.ValidTo || grp.ValidTo >= today)
        {
            RSMSubstitutionGroupRecordContract c = new RSMSubstitutionGroupRecordContract();
            c.parmGroupId(grp.GroupId);
            c.parmName(grp.Name);
            c.parmUnit(grp.Unit);
            c.parmPriceBasis(enum2Symbol(enumNum(RSMSubstitutionPriceBasis), grp.PriceBasis));
            c.parmValidFrom(grp.ValidFrom);
            c.parmValidTo(grp.ValidTo);
            c.parmNote(grp.Note);

            List    members = new List(Types::Class);
            boolean inScope = !_commodityId;
            RSMItemSubstitutionGroupMember m;
            while select m order by m.Sequence where m.GroupId == grp.GroupId
            {
                RSMSubstitutionGroupMemberContract mc = new RSMSubstitutionGroupMemberContract();
                mc.parmItemId(m.ItemId);
                mc.parmEquivQty(m.EquivQty);
                mc.parmSequence(m.Sequence);
                members.addEnd(mc);
                inScope = inScope || RSMProrationSubstitutionService::itemInCommodity(m.ItemId, _commodityId);
            }
            c.parmMembers(members);
            if (inScope)
            {
                result.addEnd(c);
            }
        }
        return result;
    }

    private static boolean itemInCommodity(ItemId _itemId, str _commodityId)
    {
        // EcoResProduct.RSMCommodityId carries the buyer-group/commodity link
        // (see the extension list in README.md).
        InventTable inventTable = InventTable::find(_itemId);
        return inventTable
            && EcoResProduct::find(inventTable.Product).RSMCommodityId == _commodityId;
    }
}
